# BA2 ML Test Platform - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=sqlite:///./backend/ml_platform.db

# =============================================================================
# API KEYS - Data Providers
# =============================================================================

# Alpha Vantage (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alphavantage_api_key

# Financial Modeling Prep (https://site.financialmodelingprep.com/developer/docs)
FMP_API_KEY=your_fmp_api_key

# Finnhub (https://finnhub.io/register)
FINNHUB_API_KEY=your_finnhub_api_key

# Alpaca Markets (https://alpaca.markets/)
ALPACA_MARKET_API_KEY=your_alpaca_api_key
ALPACA_MARKET_API_SECRET=your_alpaca_api_secret

# Polygon.io (https://polygon.io/)
POLYGON_API_KEY=your_polygon_api_key

# EODHD (https://eodhistoricaldata.com/)
EODHD_API_KEY=your_eodhd_api_key

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002

# Logging
LOG_LEVEL=INFO

# Admin token for CLI server update command (used by ba2cli.py server update)
BA2_ADMIN_TOKEN=your_secret_admin_token_here

# Worker settings
MAX_WORKERS=4

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# API URL (for frontend to connect to backend)
VITE_API_URL=http://localhost:8002

# =============================================================================
# ML/TRAINING CONFIGURATION
# =============================================================================

# Default normalization buffer percentage (for live data headroom)
DEFAULT_NORMALIZATION_BUFFER_PCT=0.35

# GPU/CUDA settings (leave empty for auto-detection)
# CUDA_VISIBLE_DEVICES=0
